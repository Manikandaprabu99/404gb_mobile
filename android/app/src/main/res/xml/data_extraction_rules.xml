<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing of this app moves to cloud backups or a new phone (Android 12+):
     - app_webview/ holds the GitHub sign-in cookie; a copy on a second phone would share
       one token, and logging out on either would sign the other out.
     - The backup ledger is keyed by this phone's MediaStore ids; on another phone those ids
       point at different files, which would then be skipped as "already backed up".
     The new phone simply signs in and rescans. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
